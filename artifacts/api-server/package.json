{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:persistence": "node --experimental-strip-types --test ./test/spa-state-store.test.mjs",
    "test:evolution-qr": "node --experimental-strip-types --test ./test/evolution-qr.test.mjs",
    "test:whatsapp-agent-safety": "node --experimental-strip-types --test ./test/whatsapp-agent-safety.test.mjs",
    "test:whatsapp-booking": "node --experimental-strip-types --test ./test/whatsapp-booking.test.mjs",
    "test:client-deduplication": "node --experimental-strip-types --test ./test/client-deduplication.test.mjs",
    "test:auth-cache": "node --experimental-strip-types --test ./test/auth-cache.test.mjs",
    "test:staff-access-password": "node --experimental-strip-types --test ./test/staff-access-password.test.mjs",
    "test:staff-access-email": "node --experimental-strip-types --test ./test/staff-access-email.test.mjs"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
